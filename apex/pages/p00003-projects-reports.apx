page 3 (
    name: Projects Reports
    alias: PROJECTS-REPORTS
    title: Projects Reports
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region projects-reports (
        name: Projects Reports
        type: form
        source {
            location: localDatabase
            tableName: XXDT_PROJECTS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P3_CREATED_BY (
        type: textField
        label {
            label: Created By
            alignment: right
        }
        layout {
            sequence: 70
            region: @projects-reports
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @projects-reports
            column: CREATED_BY
            dataType: varchar2
        }
    )

    pageItem P3_CREATED_DATE (
        type: datePicker
        label {
            label: Created Date
            alignment: right
        }
        layout {
            sequence: 80
            region: @projects-reports
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @projects-reports
            column: CREATED_DATE
            dataType: date
        }
    )

    pageItem P3_DESCRIPTION (
        type: textarea
        label {
            label: Description
            alignment: right
        }
        layout {
            sequence: 30
            region: @projects-reports
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @projects-reports
            column: DESCRIPTION
            dataType: varchar2
        }
    )

    pageItem P3_END_DATE (
        type: datePicker
        label {
            label: End Date
            alignment: right
        }
        layout {
            sequence: 60
            region: @projects-reports
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @projects-reports
            column: END_DATE
            dataType: date
        }
    )

    pageItem P3_PROJECT_ID (
        type: hidden
        layout {
            sequence: 10
            region: @projects-reports
            slot: regionBody
        }
        source {
            formRegion: @projects-reports
            column: PROJECT_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P3_PROJECT_NAME (
        type: textField
        label {
            label: Project Name
            alignment: right
        }
        layout {
            sequence: 20
            region: @projects-reports
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            formRegion: @projects-reports
            column: PROJECT_NAME
            dataType: varchar2
        }
    )

    pageItem P3_START_DATE (
        type: datePicker
        label {
            label: Start Date
            alignment: right
        }
        layout {
            sequence: 50
            region: @projects-reports
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @projects-reports
            column: START_DATE
            dataType: date
        }
    )

    pageItem P3_STATUS (
        type: textField
        label {
            label: Status
            alignment: right
        }
        layout {
            sequence: 40
            region: @projects-reports
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @projects-reports
            column: STATUS
            dataType: varchar2
        }
    )

    pageItem P3_UPDATED_BY (
        type: textField
        label {
            label: Updated By
            alignment: right
        }
        layout {
            sequence: 90
            region: @projects-reports
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @projects-reports
            column: UPDATED_BY
            dataType: varchar2
        }
    )

    pageItem P3_UPDATED_DATE (
        type: datePicker
        label {
            label: Updated Date
            alignment: right
        }
        layout {
            sequence: 100
            region: @projects-reports
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @projects-reports
            column: UPDATED_DATE
            dataType: date
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @projects-reports
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 2
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @projects-reports
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P3_PROJECT_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @projects-reports
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_PROJECT_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @projects-reports
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_PROJECT_ID
        }
    )

    process initialize-form-projects-reports (
        name: Initialize form Projects Reports
        type: formInitialization
        formRegion: @projects-reports
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 39697485651180057633
        }
    )

    process process-form-projects-reports (
        name: Process form Projects Reports
        type: formAutoRowProcessing
        formRegion: @projects-reports
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 39697486065077057634
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 2
            }
        }
    )

)

