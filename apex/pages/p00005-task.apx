page 5 (
    name: Task
    alias: TASK
    title: Task
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    help {
        helpText: Choose a project and enter a task name, status, and priority. Create or Apply Changes saves the task and returns to Tasks. Delete removes the current task after confirmation. Cancel returns without saving.
    }

    region task (
        name: Task
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXDT_TASKS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P5_TASK_ID (
        type: hidden
        layout {
            sequence: 10
            region: @task
            slot: regionBody
        }
        source {
            formRegion: @task
            column: TASK_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P5_PROJECT_ID (
        type: selectList
        label {
            label: Project
            alignment: right
        }
        layout {
            sequence: 20
            region: @task
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @task-projects
            displayExtraValues: false
            displayNullValue: true
            nullDisplayValue: - Select Project -
        }
        source {
            formRegion: @task
            column: PROJECT_ID
            dataType: number
        }
        help {
            helpText: Choose the project that owns this task.
        }
    )

    pageItem P5_TASK_NAME (
        type: textField
        label {
            label: Task Name
            alignment: right
        }
        layout {
            sequence: 30
            region: @task
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            formRegion: @task
            column: TASK_NAME
            dataType: varchar2
        }
        help {
            helpText: Enter a short, descriptive task name, up to 200 characters.
        }
    )

    pageItem P5_DESCRIPTION (
        type: textarea
        label {
            label: Description
            alignment: right
        }
        layout {
            sequence: 40
            region: @task
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @task
            column: DESCRIPTION
            dataType: varchar2
        }
        help {
            helpText: Add optional task details, up to 1000 characters.
        }
    )

    pageItem P5_STATUS (
        type: selectList
        label {
            label: Status
            alignment: right
        }
        layout {
            sequence: 50
            region: @task
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @task-statuses
            displayExtraValues: false
            displayNullValue: true
            nullDisplayValue: - Select Status -
        }
        source {
            formRegion: @task
            column: STATUS
            dataType: varchar2
        }
        default {
            type: static
            staticValue: TODO
        }
        help {
            helpText: Choose TODO, IN PROGRESS, COMPLETED, or CANCELLED.
        }
    )

    pageItem P5_PRIORITY (
        type: selectList
        label {
            label: Priority
            alignment: right
        }
        layout {
            sequence: 60
            region: @task
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @task-priorities
            displayExtraValues: false
            displayNullValue: true
            nullDisplayValue: - Select Priority -
        }
        source {
            formRegion: @task
            column: PRIORITY
            dataType: varchar2
        }
        default {
            type: static
            staticValue: MEDIUM
        }
        help {
            helpText: Choose LOW, MEDIUM, or HIGH priority.
        }
    )

    pageItem P5_DUE_DATE (
        type: datePicker
        label {
            label: Due Date
            alignment: right
        }
        layout {
            sequence: 70
            region: @task
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @task
            column: DUE_DATE
            dataType: date
        }
        help {
            helpText: Choose an optional date by which the task should be completed.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @task
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 4
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @task
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            action: submitPage
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P5_TASK_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @task
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            action: submitPage
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: Delete this task? This action cannot be undone.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P5_TASK_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @task
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            action: submitPage
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P5_TASK_ID
        }
    )

    process initialize-form-task (
        name: Initialize form Task
        type: formInitialization
        formRegion: @task
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form-task (
        name: Process form Task
        type: formAutoRowProcessing
        formRegion: @task
        execution {
            sequence: 10
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 4
            }
        }
    )

)

